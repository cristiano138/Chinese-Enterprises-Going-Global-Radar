# 环境变量 —— 复制为 .env 后填入真实值
# ⚠️ .env 已被 .gitignore 排除，不会被提交到仓库

# 大模型平台 API Token（必填）
# 在平台「访问令牌」页面生成，权限仅勾选 Model 调用相关项
MODEL_API_TOKEN=your_token_here

# 大模型接口地址（按平台文档填写）
MODEL_API_BASE=https://api-inference.modelscope.cn/v1

# 使用的模型名称
# 推荐用非推理模型，输出更稳定；若改用推理模型（如 DeepSeek 系列），
# 注意 test_connection.py / enrich_cn.py 的 max_tokens 要留足 ——
# 思考过程会吃掉大量 token，给少了会返回空字符串。
# ⚠️ 魔搭模型会下架（Qwen2.5-72B-Instruct 已下架过），部署前先跑 list_models.py 现场确认
MODEL_NAME=deepseek-ai/DeepSeek-V4.1-Flash

# 法律专业 MCP 接入凭证（可选，不影响主流程）
LEGAL_MCP_TOKEN=

# ── 语音输入（可选，全部留空 = 本地 Whisper；不支持则语音入口自动隐藏）──
# auto：有云端配置走云端，否则本地；local：只走本地；cloud：只走云端
ASR_BACKEND=auto
# 云端转写（OpenAI 兼容 /audio/transcriptions）；不配则用本地 faster-whisper
ASR_API_BASE=
ASR_API_KEY=
ASR_MODEL=
# 识别语言与本地模型尺寸（默认 zh / small）
ASR_LANG=zh
ASR_LOCAL_MODEL=small
# 本地模型目录（留空 = 自动找 ~/.cache/compliance-radar/asr/faster-whisper-small）
ASR_MODEL_DIR=

# 数据抓取配置
CRAWL_INTERVAL_SECONDS=2
CRAWL_MAX_RETRIES=3
CRAWL_TIMEOUT_SECONDS=30

# 运行配置
LOG_LEVEL=INFO
