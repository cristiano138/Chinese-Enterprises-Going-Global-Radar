# 环境变量 —— 复制为 .env 后填入真实值
# ⚠️ .env 已被 .gitignore 排除，不会被提交到仓库

# 大模型平台 API Token（必填）
# 在平台「访问令牌」页面生成，权限仅勾选 Model 调用相关项
MODEL_API_TOKEN=your_token_here

# 大模型接口地址（按平台文档填写）
MODEL_API_BASE=https://api-inference.modelscope.cn/v1

# 使用的模型名称
# 推荐用非推理模型，输出更稳定；若改用推理模型（如 DeepSeek 系列），
# 注意 test_connection.py / enrich_cn.py 的 max_tokens 要留足 ——
# 思考过程会吃掉大量 token，给少了会返回空字符串。
# ⚠️ 魔搭模型会下架（Qwen2.5-72B-Instruct 已下架过），部署前先跑 list_models.py 现场确认
MODEL_NAME=deepseek-ai/DeepSeek-V4.1-Flash

# 法律专业 MCP 接入凭证（可选，不影响主流程）
LEGAL_MCP_TOKEN=

# ── 语音输入（可选；未准备本地引擎且未配置云端时入口置灰）──
# auto：云端（配了才用）→ 本地 sherpa-onnx 引擎 → 本地 Whisper → 关闭
# 本地引擎属外部二进制，不装 Python 库：python scripts/prepare_asr_engine.py
ASR_BACKEND=auto
# 云端转写（OpenAI 兼容 /audio/transcriptions）；不配则用本地引擎
ASR_API_BASE=
ASR_API_KEY=
ASR_MODEL=
# 识别语言（默认 zh；填 auto 交给 SenseVoice 判语言）
ASR_LANG=zh
# 本地引擎根目录（留空 = <项目>/models/sherpa-onnx）
ASR_ENGINE_DIR=
# 引擎版本与模型包（一般不用改）
ASR_ENGINE_VERSION=v1.13.8
ASR_ENGINE_MODEL=sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2024-07-17
# 每个转写进程的线程数（2 核机器填 2）
ASR_ENGINE_THREADS=2
# 1 = 启动时后台自动下载引擎与模型；0 = 只认现成文件（离线/内网部署用）
ASR_ENGINE_AUTO_DOWNLOAD=1
# 常驻识别服务：auto（默认，失败自动退回命令行）| on | off
# 开启后模型只加载一次，单句转写从约 3s 降到约 0.3s（本机实测）
ASR_ENGINE_SERVER=auto
# 常驻服务端口，0 = 自动挑空闲端口
ASR_ENGINE_SERVER_PORT=0
# 下载源前缀（国内网络不顺时可换镜像）
ASR_ENGINE_BASE_URL=
# 默认不保存转写文本；设为 1 才启用本地缓存（7天、最多256条/4MiB）
ASR_CACHE_ENABLED=0

# 历史后端（ASR_BACKEND=local 才用，不再推荐）
ASR_LOCAL_MODEL=small
ASR_MODEL_DIR=

# 可选 SQLite 条款库：必须是已存在且结构完整的库；留空探测 sqlite/regulations.sqlite3
COMPLIANCE_DB_PATH=

# 数据抓取配置
CRAWL_INTERVAL_SECONDS=2
CRAWL_MAX_RETRIES=3
CRAWL_TIMEOUT_SECONDS=30

# 运行配置
LOG_LEVEL=INFO
